{
  "manifest_version": 3,
  "name": "Silverback",
  "version": "1.1.0",
  "description": "Your GitHub productivity at a glance. Ship like you mean it.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Silverback", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.github.com/*"]
}
